{
    "name": "ipase/ipase-php",
    "description": "Ipase server-side SDK for PHP and Laravel: track and identify events from your backend, batched to the Ipase ingest service",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "ipase",
        "analytics",
        "product analytics",
        "laravel"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "laravel/framework": "For the service provider, the Ipase facade and queued delivery (Laravel 11 or later)"
    },
    "autoload": {
        "psr-4": {
            "Ipase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ipase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ipase\\Laravel\\IpaseServiceProvider"
            ],
            "aliases": {
                "Ipase": "Ipase\\Laravel\\Facades\\Ipase"
            }
        },
        "ipase": {
            "spec": "1.0.0-draft.4"
        }
    },
    "scripts": {
        "test": "pest --testsuite=Unit,Laravel",
        "conformance": "pest --testsuite=Conformance",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@conformance"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
